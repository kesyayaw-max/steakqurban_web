<!DOCTYPE html><html lang="id"><head><%- include("partials/head", {site}) %></head><body><%- include("partials/nav", {site}) %><main class="container page"><p class="pill">🎉 EVENTS</p><h1>Daftar Event</h1><section class="cards"><% events.forEach(e=>{ %><article class="card big accent-<%= e.accent || 'purple' %>"><span class="badge"><%= e.status %></span><h3><%= e.title %></h3><p><%= e.desc %></p><div class="meta"><span><%= e.category %></span><span><%= e.date %></span><span><%= e.prize %></span></div></article><% }) %></section></main><script src="/app.js"></script></body></html>